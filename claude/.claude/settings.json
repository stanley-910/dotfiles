{
  "env": {
    "PATH": "/Users/stanwang/dotfiles/scripts/bin:/Users/stanwang/.headroom/bin:/Users/stanwang/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/Applications/Obsidian.app/Contents/MacOS:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787"
  },
  "permissions": {
    "allow": [
      "mcp__deepwiki__ask_question",
      "mcp__deepwiki__read_wiki_contents",
      "mcp__deepwiki__read_wiki_structure",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "defaultMode": "bypassPermissions",
    "skipDangerousModePermissionPrompt": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-link-autorecord.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "obsidian@obsidian-skills": false,
    "frontend-design@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "superwhisper": {
      "source": {
        "source": "github",
        "repo": "superultrainc/superwhisper-claude-code"
      }
    }
  },
  "skillOverrides": {
    "interview-prep-coach": "user-invocable-only",
    "nvim-coach": "user-invocable-only",
    "shell-coach": "user-invocable-only",
    "domain-modeling": "user-invocable-only",
    "dotfiles-drift": "off",
    "caveman": "name-only",
    "write-a-skill": "name-only",
    "claude-api": "off",
    "update-config": "user-invocable-only",
    "deep-research": "user-invocable-only",
    "schedule": "user-invocable-only",
    "run": "user-invocable-only",
    "loop": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "security-review": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "off",
    "review": "off",
    "frontend-design": "user-invocable-only"
  },
  "viewMode": "verbose",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "showTurnDuration": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
