#!/bin/sh
# Apply a staged document-script tree inside one tldraw watcher debounce window.
set -eu

usage() {
  echo 'usage: tq-sync <DOC_ID> <SOURCE_DIR> [--delete]' >&2
  exit 2
}

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
doc_id=$1
source_dir=$2
delete_mode=${3-}
[ -d "$source_dir" ] || { echo "tq-sync: source directory not found: $source_dir" >&2; exit 1; }
[ -f "$source_dir/main.js" ] || { echo "tq-sync: staged tree must contain main.js" >&2; exit 1; }
[ -z "$delete_mode" ] || [ "$delete_mode" = '--delete' ] || usage
command -v jq >/dev/null 2>&1 || { echo 'tq-sync: jq is required' >&2; exit 127; }
command -v rsync >/dev/null 2>&1 || { echo 'tq-sync: rsync is required' >&2; exit 127; }

skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tq="$skill_dir/tq"
workspace=$(sh "$tq" POST "/api/doc/$doc_id/script-workspace")
error=$(printf '%s' "$workspace" | jq -r '.error // empty')
[ -z "$error" ] || { echo "tq-sync: $error" >&2; exit 1; }
script_dir=$(printf '%s' "$workspace" | jq -er '.result.scriptDir // .scriptDir')

if [ "$delete_mode" = '--delete' ]; then
  rsync -a --delay-updates --delete-after \
    --exclude '.DS_Store' --exclude 'node_modules' --exclude '*.tmp' \
    "$source_dir/" "$script_dir/"
else
  rsync -a --delay-updates \
    --exclude '.DS_Store' --exclude 'node_modules' --exclude '*.tmp' \
    "$source_dir/" "$script_dir/"
fi

attempt=0
while [ "$attempt" -lt 50 ]; do
  sleep 0.1
  status=$(sh "$tq" GET "/api/doc/$doc_id/script-status")
  state=$(printf '%s' "$status" | jq -r '.result.state // .state // "unknown"')
  case "$state" in
    applied)
      printf '%s\n' "$status"
      exit 0
      ;;
    error)
      printf '%s\n' "$status" >&2
      exit 1
      ;;
  esac
  attempt=$((attempt + 1))
done

printf '%s\n' "$status" >&2
echo 'tq-sync: watcher did not reach applied state within 5 seconds' >&2
exit 1
