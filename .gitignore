# Homebrew Bundle lock file - tracks exact versions installed
Brewfile.lock.json
/.claude/*
!/.claude/settings.json
.emdash.json

# Karabiner runtime files (full dir is stowed; only karabiner.json is tracked)
karabiner/.config/karabiner/*
!karabiner/.config/karabiner/karabiner.json

# Tooling artifacts (not config): rpiv skill output + context-mode index
.rpiv/
index.txt
/.pi/subagent-schedules/
/pi-session-*.html

/.crew/
/.crew
!.crew/artifacts/
!.crew/graphs/
!.crew/artifacts/.gitkeep
!.crew/graphs/.gitkeep
