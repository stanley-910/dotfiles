# ============================================================================
# External Brewfile - Additional system packages
# ============================================================================
# This file contains packages that are not directly required by dotfiles
# but are useful development tools and system utilities you had installed.
#
# Install with: brew bundle install --file=Brewfile.external
#
# Review this file and comment out anything you don't need on your fresh install.
# ============================================================================

# ============================================================================
# Development Languages & Runtimes
# ============================================================================

# Node.js - JavaScript runtime (current Homebrew stable)
brew "node"

# Python - one Homebrew version; project envs are managed by uv
brew "python@3.14"
brew "uv"                # Python package/project manager (replaces pipx/pyenv)

# Go toolchain
brew "go"

# ============================================================================
# Text Editors & Development Tools
# ============================================================================

# Neovim - Hyperextensible Vim-based text editor
brew "neovim"

# Typst - Modern markup-based typesetting system (nvim/zed configs reference it)
brew "typst"

# Language servers / parsers
brew "tree-sitter-cli"   # Tree-sitter grammar compiler (nvim)

# ============================================================================
# Terminal Tools & Utilities
# ============================================================================

# Tree - Directory listing in tree format
brew "tree"

# Terminal viewers & media
brew "mpv"               # Video player
brew "httpie"            # Friendly HTTP client

# System care
brew "mole"              # Deep clean and optimize your Mac

# ============================================================================
# Build Tools & Libraries
# ============================================================================

# Build systems
brew "cmake"             # Cross-platform build system
brew "ninja"             # Small build system focused on speed

# ============================================================================
# Version Control & Git Tools
# ============================================================================

brew "gh"                # GitHub CLI
brew "glab"              # GitLab CLI
brew "lazygit"           # Git TUI (config tracked in lazygit package)
brew "diff-so-fancy"     # Diff pager used by lazygit config
brew "worktrunk"         # Git worktree CLI for parallel agent workflows (wt)
tap "modem-dev/tap"
brew "hunk"              # Terminal diff viewer for agent-authored changesets (modem-dev/tap)

# Git LFS (Large File Storage) - Implied by git config
# brew "git-lfs"         # Uncomment if you use Git LFS

# ============================================================================
# Shell & Script Quality
# ============================================================================

brew "shellcheck"        # Shell script linter
brew "shfmt"             # Shell script formatter

# ============================================================================
# Agent Tooling
# ============================================================================

brew "rtk"               # Rust Token Killer - token-optimized CLI proxy

# ============================================================================
# Multimedia Tools
# ============================================================================

# FFmpeg - Complete multimedia solution
brew "ffmpeg"

# Image processing
brew "imagemagick"       # Image manipulation tools

# ============================================================================
# Database & Data Tools
# ============================================================================

# SQLite - Embedded database
brew "sqlite"

# JQ - JSON processor
brew "jq"

# ============================================================================
# macOS GUI Applications (Casks)
# ============================================================================

# System utilities you had installed
cask "alt-tab"           # Windows-style alt-tab window switcher
cask "betterdisplay"     # Display management tool
cask "monitorcontrol"    # External monitor brightness/volume control
cask "mos"               # Smooth scrolling and mouse control

# Nerd Fonts - Fonts with icons for terminal
# Note: Fonts are now part of homebrew-cask (no separate tap needed)
cask "font-hack-nerd-font"
cask "font-symbols-only-nerd-font"

# ============================================================================
# Optional: Package Managers for Other Languages
# ============================================================================

# Uncomment if you use these languages:
# brew "opam"            # OCaml package manager (you have this installed)
# brew "rbenv"           # Ruby version manager

# ============================================================================
# Notes
# ============================================================================
# Many libraries (gtk+3, cairo, glib, etc.) are dependencies and will be
# automatically installed by the packages above. They're not listed separately.
#
# Review and uncomment Git LFS if you use it in your repos.
# ============================================================================

