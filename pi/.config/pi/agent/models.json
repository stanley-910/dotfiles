{
  "providers": {
    "headroom-copilot": {
      "baseUrl": "http://127.0.0.1:8787/v1",
      "api": "openai-responses",
      "apiKey": "headroom-local",
      "headers": {
        "User-Agent": "GitHubCopilotChat/0.35.0",
        "Editor-Version": "vscode/1.107.0",
        "Editor-Plugin-Version": "copilot-chat/0.35.0",
        "Copilot-Integration-Id": "vscode-chat",
        "X-Initiator": "user"
      },
      "models": [
        {
          "id": "gpt-5.5",
          "name": "GPT-5.5 via Headroom/Copilot",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": "low",
            "xhigh": "xhigh"
          },
          "input": ["text", "image"],
          "contextWindow": 400000,
          "maxTokens": 128000,
          "cost": {
            "input": 5,
            "output": 30,
            "cacheRead": 0.5,
            "cacheWrite": 0
          }
        }
      ]
    }
  }
}
