# Stow ignore list for the `scripts` package.
#
# `bin/` is intentionally NOT stowed: it is added to $PATH directly from
# .zshenv (export PATH="$HOME/dotfiles/scripts/bin:$PATH"), so scripts dropped
# there are globally runnable immediately — no symlink, no restow. Stowing it
# would also create a stray ~/bin symlink, which we don't want.
#
# NOTE: providing this file REPLACES stow's built-in default ignore list, so
# the VCS/README/LICENSE patterns below are re-declared to keep them ignored.
^/bin$

# launchd rejects this plist when Stow installs it as a symlink. Keep the
# versioned source here, but deploy it as a real file in ~/Library/LaunchAgents.
^/Library/LaunchAgents/com\.stanwang\.headroom-proxy\.plist$

# stow defaults (kept):
\.git
\.gitignore
^/README.*
^/LICENSE.*
