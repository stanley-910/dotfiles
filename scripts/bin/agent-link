#!/usr/bin/env bash

# agent-link — record & open the issue / MR an agent is working on, per-worktree.
#
# Agents (claude / pi / any harness) run the setters from inside their worktree;
# tmux keybinds (git-menu: m / i / y) run the read commands from the pane.
#
# Metadata lives in per-worktree git config (.git/worktrees/<name>/config.worktree),
# so it is scoped to the agent's worktree and garbage-collected with it. Discovery
# from the pane (whose cwd usually stays in the MAIN checkout) is layered:
#   1. @agent_worktree pane option — fast path, set by the setter via $TMUX_PANE.
#      Fragile on purpose: pane options die with the pane, and some agent
#      harnesses strip TMUX_PANE from subprocess env.
#   2. Scan the pane repo's linked worktrees for agent.* recordings (newest
#      config.worktree mtime wins). Needs no pane state at all.
#   3. For `open mr` with nothing recorded: glab/gh branch lookup.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  agent-link issue <url>      Record the issue being worked on (replaces)
  agent-link mr <url>         Record the MR/PR opened (replaces)
  agent-link add issue|mr <url>   Append another link (multiple MRs)
  agent-link clear [issue|mr]     Clear recorded links (default: both)
  agent-link status           Show recordings across the repo's worktrees

  agent-link open issue|mr    Open recorded link(s) in browser
                              (mr falls back to glab/gh branch lookup)
  agent-link path             Print the agent worktree path
  agent-link copy             Copy the agent worktree path to clipboard

Setters resolve the worktree from cwd. Read commands resolve: pane pointer ->
newest agent.* recording among the repo's worktrees -> newest linked worktree.
EOF
  exit 1
}

# --- context ------------------------------------------------------------------

# Where the pane "is": pane cwd inside tmux, else our own cwd.
pane_path() {
  if [[ -n "${TMUX:-}" ]]; then
    # In a display-popup, display-message resolves against the underlying
    # active pane (same mechanism open_remote.sh relies on).
    tmux display-message -p '#{pane_current_path}'
  else
    pwd
  fi
}

pane_pointer() {
  [[ -n "${TMUX:-}" ]] || return 0
  tmux display-message -p '#{@agent_worktree}' 2>/dev/null || true
}

# User feedback that survives the popup closing: tmux status line if available.
notify() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux display-message "$1"
  else
    echo "$1"
  fi
}

# --- setters (run by agents, from inside their worktree) -----------------------

cwd_worktree() {
  git rev-parse --show-toplevel 2>/dev/null || {
    echo "agent-link: not inside a git worktree" >&2
    exit 1
  }
}

ensure_worktree_config() {
  # Without this extension, `git config --worktree` silently degrades to
  # --local (shared across all worktrees). Idempotent; sparse-checkout
  # enables it the same way.
  git config extensions.worktreeConfig true
}

point_pane_here() {
  local top="$1"
  if [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    tmux set-option -p -t "$TMUX_PANE" @agent_worktree "$top" 2>/dev/null || true
  fi
}

set_link() {
  local kind="$1" url="$2" mode="${3:-replace}"
  local top
  top=$(cwd_worktree)
  cd "$top"
  ensure_worktree_config
  if [[ "$mode" == "add" ]]; then
    git config --worktree --add "agent.$kind" "$url"
  else
    git config --worktree --replace-all "agent.$kind" "$url"
  fi
  # Recording from a linked worktree supersedes the same URL recorded on the
  # main checkout — pinned-cwd harnesses (pi) grab before their worktree
  # exists, then re-record from it; don't leave the stale duplicate behind.
  local gd main
  gd=$(git rev-parse --absolute-git-dir)
  if [[ "$gd" == */worktrees/* ]]; then
    main=$(dirname "$(common_dir "$top")")
    git -C "$main" config --worktree --fixed-value --unset-all "agent.$kind" "$url" 2>/dev/null || true
  fi
  point_pane_here "$top"
  echo "agent-link: recorded $kind -> $url ($top)"
}

clear_links() {
  local top
  top=$(cwd_worktree)
  cd "$top"
  for kind in "$@"; do
    git config --worktree --unset-all "agent.$kind" 2>/dev/null || true
  done
  echo "agent-link: cleared ${*} ($top)"
}

# --- discovery (read side) ------------------------------------------------------

common_dir() { # repo-ish path -> absolute git common dir
  git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null
}

# Worktrees with a recording of $kind (or any, if kind empty), newest first.
# Reads config.worktree files straight out of the common gitdir instead of
# spawning `git -C` per worktree — a repo with dozens of worktrees made the
# old scan take ~1s per keypress; only worktrees that ever recorded even
# have a config.worktree, so this touches a handful of files.
recorded_worktrees() {
  local kind="$1" ref="$2" common f d wt
  common=$(common_dir "$ref") || return 0
  [[ -n "$common" ]] || return 0
  for f in "$common/config.worktree" "$common"/worktrees/*/config.worktree; do
    [[ -f "$f" ]] || continue
    if [[ -n "$kind" ]]; then
      git config --file "$f" --get "agent.$kind" >/dev/null 2>&1 || continue
    else
      git config --file "$f" --get-regexp '^agent\.' >/dev/null 2>&1 || continue
    fi
    if [[ "$f" == "$common/config.worktree" ]]; then
      wt=$(dirname "$common") # main checkout
    else
      d=${f%/config.worktree}
      wt=$(dirname "$(cat "$d/gitdir" 2>/dev/null)") || continue
    fi
    [[ -d "$wt" ]] || continue
    printf '%s\t%s\n' "$(stat -f '%m' "$f")" "$wt"
  done | sort -rn | cut -f2
}

# The single worktree read commands act on.
#   kind empty = for path/copy (any recording, then newest linked worktree).
resolve_worktree() {
  local kind="${1:-}" ref hit

  # cwd first: when invoked from inside an agent session (/mr, /issue), cwd IS
  # that session's worktree — never answer with a sibling agent's recording.
  # From a tmux popup cwd is the pane path (main checkout), which won't match.
  local cwdtop cwdgd
  cwdtop=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -n "$cwdtop" ]]; then
    if [[ -n "$kind" ]]; then
      if git -C "$cwdtop" config --worktree --get "agent.$kind" >/dev/null 2>&1; then
        echo "$cwdtop"
        return 0
      fi
    else
      cwdgd=$(git rev-parse --absolute-git-dir 2>/dev/null || true)
      if [[ "$cwdgd" == */worktrees/* ]]; then
        echo "$cwdtop" # a linked worktree: cwd is the agent worktree
        return 0
      fi
    fi
  fi

  ref=$(pane_path)

  # NOTE: the @agent_worktree pane pointer is deliberately NOT consulted here.
  # Panes outlive agent sessions, so a stale pointer shadows fresher work
  # (observed: yesterday's worktree hijacking today's hotkeys). Newest
  # recording wins; the pointer survives only as debug info in `status`.
  if [[ -z "$kind" ]]; then
    # path/copy answer "where is the agent working" — the main checkout is
    # never that answer (it's where the user already is). Links recorded
    # there still count for open.
    local main_wt common
    common=$(common_dir "$ref") || true
    main_wt=$(dirname "${common:-/nonexistent}")
    hit=$(recorded_worktrees "$kind" "$ref" | grep -vxF "$main_wt" | head -1)
  else
    hit=$(recorded_worktrees "$kind" "$ref" | head -1)
  fi
  if [[ -n "$hit" ]]; then
    echo "$hit"
    return 0
  fi

  if [[ -z "$kind" ]]; then
    # path/copy with no recordings: newest-touched linked worktree is the best
    # guess for "the agent's worktree" (gitdir mtime tracks HEAD activity).
    local common
    common=$(git -C "$ref" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || true
    if [[ -n "${common:-}" && -d "$common/worktrees" ]]; then
      hit=$(for d in "$common"/worktrees/*/; do
        [[ -f "${d}gitdir" ]] || continue
        wt=$(dirname "$(cat "${d}gitdir")")
        [[ -d "$wt" ]] && printf '%s\t%s\n' "$(stat -f '%m' "$d")" "$wt"
      done | sort -rn | head -1 | cut -f2)
      if [[ -n "$hit" ]]; then
        echo "$hit"
        return 0
      fi
    fi
  fi

  echo "$ref"
}

# --- read commands (run from tmux keybinds or by hand) --------------------------

open_links() {
  local kind="$1" wt urls
  wt=$(resolve_worktree "$kind")
  urls=$(git -C "$wt" config --worktree --get-all "agent.$kind" 2>/dev/null || true)

  if [[ -z "$urls" && "$kind" == "mr" ]]; then
    # Derive from the branch via forge CLI. Never stale, covers agents that
    # forgot to record.
    local remote=""
    remote=$(git -C "$wt" remote get-url origin 2>/dev/null || true)
    if [[ "$remote" == *gitlab* ]] && command -v glab >/dev/null 2>&1; then
      notify "agent-link: no recorded MR — trying glab branch lookup"
      (cd "$wt" && glab mr view --web) && return 0
    elif [[ "$remote" == *github.com* ]] && command -v gh >/dev/null 2>&1; then
      notify "agent-link: no recorded PR — trying gh branch lookup"
      (cd "$wt" && gh pr view --web) && return 0
    fi
  fi

  if [[ -z "$urls" ]]; then
    notify "agent-link: no $kind recorded in any worktree of $(basename "$wt")"
    exit 1
  fi

  local n=0
  while IFS= read -r url; do
    [[ -z "$url" ]] && continue
    open "$url"
    n=$((n + 1))
  done <<<"$urls"
  notify "agent-link: opened $n $kind link(s) from $wt"
}

show_status() {
  local ref wt
  ref=$(pane_path)
  echo "pane: $ref"
  echo "pointer: $(pane_pointer)"
  echo "recordings (newest first):"
  while IFS= read -r wt; do
    echo "  $wt"
    git -C "$wt" config --worktree --get-regexp '^agent\.' 2>/dev/null |
      sed 's/^agent\./    /'
  done < <(recorded_worktrees "" "$ref")
}

copy_path() {
  local wt
  wt=$(resolve_worktree "")
  printf '%s' "$wt" | pbcopy
  notify "agent-link: copied $wt"
}

# --- dispatch -------------------------------------------------------------------

cmd="${1:-}"
case "$cmd" in
issue | mr)
  [[ -n "${2:-}" ]] || usage
  set_link "$cmd" "$2"
  ;;
add)
  [[ "${2:-}" == "issue" || "${2:-}" == "mr" ]] || usage
  [[ -n "${3:-}" ]] || usage
  set_link "$2" "$3" add
  ;;
clear)
  case "${2:-}" in
  issue | mr) clear_links "$2" ;;
  "") clear_links issue mr ;;
  *) usage ;;
  esac
  ;;
open)
  [[ "${2:-}" == "issue" || "${2:-}" == "mr" ]] || usage
  open_links "$2"
  ;;
path)
  resolve_worktree ""
  ;;
copy)
  copy_path
  ;;
status)
  show_status
  ;;
*)
  usage
  ;;
esac
