#!/usr/bin/env bash
# Switch the BetterDisplay iPad virtual screen between landscape and portrait
# and keep the display arrangement anchored.
#
#   ipad-rotate [portrait|landscape|toggle] [left|right]
#
# portrait  = Rotated Orientation on  + stream rotated 270°
# landscape = Rotated Orientation off + stream rotation 0°
#
# The virtual screen sits flush against the built-in display on the given
# side (defaults to its current side). The physical iPad (s-ipad) is parked
# fully diagonal on the opposite top corner, touching only at the corner.
set -euo pipefail

VSCREEN="vertical ipad"        # BetterDisplay virtual screen name
SIDECAR="s-ipad"               # physical iPad display name
BUILTIN="Built-in Display"
STREAM_PORTRAIT_ROT=270        # matches the manual Stream Virtual Screen step
RES_LANDSCAPE=1373x954         # HiDPI mode; flipping resets the mode, so we
RES_PORTRAIT=954x1373          # re-pin it on every switch

bd() { betterdisplaycli "$@"; }

mode="${1:-toggle}"
side="${2:-}"

flipped="$(bd get -name="$VSCREEN" -flipped)"

case "$mode" in
  toggle)
    if [[ "$flipped" == "on" ]]; then mode=landscape; else mode=portrait; fi ;;
  portrait|landscape) ;;
  *) echo "usage: ipad-rotate [portrait|landscape|toggle] [left|right]" >&2; exit 2 ;;
esac

if [[ -z "$side" ]]; then
  placement="$(bd get -name="$VSCREEN" -placement)"
  cur_x="${placement%x*}"
  if (( cur_x < 0 )); then side=left; else side=right; fi
fi

if [[ "$mode" == "portrait" ]]; then
  [[ "$flipped" == "on" ]] || bd set -name="$VSCREEN" -flipped=on
  rot=$STREAM_PORTRAIT_ROT
  res=$RES_PORTRAIT
else
  [[ "$flipped" == "off" ]] || bd set -name="$VSCREEN" -flipped=off
  rot=0
  res=$RES_LANDSCAPE
fi

# The flip reconfigures the framebuffer; give macOS a moment before touching
# the mode, the stream and the arrangement.
sleep 3

# Setting the mode it is already in returns an error, so only set on change.
[[ "$(bd get -name="$VSCREEN" -resolution)" == "$res" ]] || \
  bd set -name="$VSCREEN" -resolution=$res -hiDPI=on
bd set -name="$VSCREEN" -stream -rotateBy=$rot

# Placement uses logical points, i.e. the mode we just set.
vs_w="${res%x*}"
builtin_res="$(bd get -name="$BUILTIN" -resolution)"
bi_w="${builtin_res%x*}"

if [[ "$side" == "left" ]]; then
  bd set -name="$VSCREEN" -placement="$(( -vs_w ))x0"
else
  bd set -name="$VSCREEN" -placement="${bi_w}x0"
fi

# Park the physical iPad on the opposite top corner (skip if not connected).
if sidecar_res="$(bd get -name="$SIDECAR" -resolution 2>/dev/null)"; then
  sc_w="${sidecar_res%x*}"
  sc_h="${sidecar_res#*x}"
  if [[ "$side" == "left" ]]; then sc_x=$bi_w; else sc_x=$(( -sc_w )); fi
  bd set -name="$SIDECAR" -placement="${sc_x}x$(( -sc_h ))"
fi

echo "iPad virtual screen: $mode, $side of built-in display"
