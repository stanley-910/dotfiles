#!/bin/sh
# talk — speak Claude Code replies out loud (turn it on, and say what that costs).
#
#   talk            enable for THIS session, and print the full privacy disclosure
#   talk --global   enable for every session on this machine
#   talk cycle      one key: off -> on, playing -> paused, paused -> playing
#   talk pause      freeze the speaker where it is
#   talk unpause    continue from where it froze
#   talk speed      how fast it talks, and where that number came from
#   talk status     what is enabled, and is a speaker actually playing right now?
#   talk --help     usage plus the same disclosure
#
# There is deliberately no skill and no shell alias: this is a plain PATH
# executable so it can be driven from Claude Code's `!` mode. Enabling only
# writes a flag file — the Stop hook (~/.claude/hooks/cc-talk-stop.sh) checks
# it after every turn and hands the reply to cc-talk-speak.
#
# The flag is per-session: one file per Claude Code session under
# ~/.claude/cc-talk/on/, named for $CLAUDE_CODE_SESSION_ID (the same id the
# hook reads off its stdin payload). Turning it on in one session leaves every
# other session silent. `talk --global` is the explicit opt-in to the old
# machine-wide behaviour.
#
# Turn it off with `gag`.
set -u

prog=${0##*/}
state_dir="$HOME/.claude/cc-talk"
on_dir="$state_dir/on"
pane_dir="$state_dir/panes"
pid_file="$state_dir/speaker.pid"
state_file="$state_dir/state"
speed_file="$state_dir/speed"
legacy_flag="$HOME/.claude/talk-on"

speed_min=0.50
speed_max=3.00
speed_default=1.25

disclosure() {
	cat <<'EOF'
Before it speaks anything, here is what that means:

  cc-talk sends cleaned assistant text to OpenAI to generate speech. OpenAI
  may retain API content for up to 30 days for abuse monitoring unless your
  organization has approved data-retention controls. Audio is streamed to a
  local player and is not saved by cc-talk.

cc-talk does not intentionally log or persist API keys or authorization
headers, the original or cleaned spoken text, response audio bytes, raw
OpenAI error bodies, or environment dumps.

Only assistant replies are spoken. Your prompts, tool output, and file
contents are not sent — but an assistant reply can quote any of them, so
treat anything Claude says back as text that may leave the machine.

Run `gag` to turn this off; it also stops playback already in flight.
EOF
}

usage() {
	cat <<EOF
$prog — speak Claude Code replies out loud

Usage:
  $prog            enable for this session, print the disclosure below
  $prog --global   enable for every session on this machine
  $prog cycle      one key: off -> on, playing -> paused, paused -> playing
  $prog pause      freeze playback at its exact position
  $prog unpause    continue from the paused position
  $prog speed      print the speed in force and where it came from
  $prog speed N    set the speed, e.g. \`$prog speed 1.50\` ($speed_min-$speed_max)
  $prog speed +N   nudge it, e.g. \`$prog speed +0.10\` or \`$prog speed -0.10\`
  $prog speed reset
                   forget the setting and fall back to \$PI_TALK_SPEED or $speed_default
  $prog status     show what is enabled and whether a speaker is live
  $prog cycle --pane ID
                   cycle the session living in tmux pane ID — what C-S-Space runs
  $prog -h         this help

Speed changes take effect on the next chunk, so nudging the speed mid-reply
is heard within a sentence or so rather than at the next turn.

Enabling is per-session: other Claude Code sessions stay silent until you
run $prog in them too. Turn it off with \`gag\` (\`gag --all\` for every session).

The tmux key knows which session you are looking at because each session
claims its pane — on its first completed turn, or the first time you run
\`$prog\` in it. Until one of those happens the key has nothing to act on and
says so. Moving a pane (break-pane, join-pane) leaves the claim on the old
pane id until the next turn re-claims it.

EOF
	disclosure
}

# Flag files are named after the session id, so strip anything that would make
# a surprising filename. Pane files get the same treatment — a tmux pane id is
# `%12`, and a bare `%` in a filename invites trouble. The Stop hook applies
# the identical transform to both.
session_key() {
	printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]/_/g'
}

# Which session lives in this tmux pane? The Stop hook writes the map; this
# only reads it, and prints nothing when the pane has never been claimed.
pane_session() {
	[ -n "$1" ] || return 1
	claimed=$(sed -n '1p' "$pane_dir/$(session_key "$1")" 2>/dev/null)
	[ -n "$claimed" ] || return 1
	printf '%s\n' "$claimed"
}

# Claim the pane we were run from, so the tmux key can reach this session
# before it has ever finished a turn. Best-effort: no pane, no claim, no fuss.
record_pane() {
	[ -n "${TMUX_PANE:-}" ] || return 0
	mkdir -p "$pane_dir" 2>/dev/null || return 0
	printf '%s\n' "$1" >"$pane_dir/$(session_key "$TMUX_PANE")" 2>/dev/null || true
	return 0
}

# Dead sessions never clean up after themselves, so every run sweeps flags
# nobody has touched in a week. `global` is an explicit standing choice rather
# than a session, so it is never swept.
prune_stale() {
	[ -d "$on_dir" ] || return 0
	find "$on_dir" -type f -mtime +7 ! -name global -exec rm -f {} + 2>/dev/null || true
}

# The machine-wide flag this replaced. Remove it on sight so it cannot be
# mistaken for a live setting; the hook already ignores it.
drop_legacy() {
	[ -e "$legacy_flag" ] && rm -f "$legacy_flag" 2>/dev/null
	return 0
}

# Is this session id switched on? The machine-wide flag speaks for every
# session, so it counts for all of them.
id_enabled() {
	[ -e "$on_dir/global" ] || [ -e "$on_dir/$(session_key "$1")" ]
}

# Will replies in the shell we were invoked from be spoken? Global counts:
# it speaks for this session too.
session_enabled() {
	[ -e "$on_dir/global" ] && return 0
	[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || return 1
	id_enabled "$CLAUDE_CODE_SESSION_ID"
}

# Print the pid of a live speaker, if there is one. The daemon writes a JSON
# pidfile; a stale file — process gone, or its pid recycled onto something that
# is not the speaker — reads as silence, the same trust rule the engine applies.
live_speaker() {
	[ -f "$pid_file" ] || return 1
	pid=$(sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$pid_file" 2>/dev/null | head -n 1)
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	ps -o command= -p "$pid" 2>/dev/null | grep -q cc-talk-speak || return 1
	printf '%s\n' "$pid"
}

# playing | paused | idle. The state file only means something while a live
# pidfile backs it, and a live speaker with no readable state is mid-sentence:
# the daemon writes `playing` before it can ever be frozen.
speaker_state() {
	if ! live_speaker >/dev/null 2>&1; then
		printf 'idle\n'
		return 0
	fi
	case $(cat "$state_file" 2>/dev/null) in
		paused) printf 'paused\n' ;;
		*) printf 'playing\n' ;;
	esac
}

# POSIX sh has no float math, so every speed calculation is one awk call.
#
# Does this look like a number at all? A typo (`talk speed fast`) must be an
# error rather than a silent clamp to the floor, and awk would happily coerce
# it to 0. Deltas carry their sign; absolute values do not.
speed_is_number() {
	[ -n "$1" ] || return 1
	awk -v raw="$1" 'BEGIN { exit (raw ~ /^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)$/) ? 0 : 1 }'
}

# Print a numeric speed pulled into range, at the two decimals the file uses.
# Setting is forgiving: `talk speed 9` means "as fast as it goes".
speed_clamp() {
	awk -v raw="$1" -v lo="$speed_min" -v hi="$speed_max" 'BEGIN {
		v = raw + 0
		if (v < lo) v = lo
		if (v > hi) v = hi
		printf "%.2f\n", v
	}'
}

# Print a numeric speed at two decimals only when it already sits inside the
# range; fail otherwise. Reading is strict where setting is forgiving — a
# hand-edited out-of-range file is ignored here exactly as the daemon ignores
# it, so this never reports a speed nothing will actually play.
speed_in_range() {
	speed_is_number "$1" || return 1
	awk -v raw="$1" -v lo="$speed_min" -v hi="$speed_max" 'BEGIN {
		v = raw + 0
		if (v < lo || v > hi) exit 1
		printf "%.2f\n", v
	}'
}

# Print "<speed> <source>" for the speed a daemon spawned right now would use:
# the file wins, $PI_TALK_SPEED seeds a daemon when there is no file, and the
# built-in default backs both.
speed_effective() {
	if value=$(speed_in_range "$(cat "$speed_file" 2>/dev/null)"); then
		printf '%s file\n' "$value"
	elif value=$(speed_in_range "${PI_TALK_SPEED:-}"); then
		printf '%s PI_TALK_SPEED\n' "$value"
	else
		printf '%.2f default\n' "$speed_default"
	fi
}

# Mutations are driven from tmux keys as well as from a shell, and stdout from
# a tmux run-shell keybind opens the fullscreen report view — so under tmux the
# confirmation goes to the status line, the same split `cycle` makes. Queries
# are always stdout: they are asked for, and their answer is the point.
confirm() {
	if [ -n "${TMUX:-}" ]; then
		tmux display-message "cc-talk: $1"
	else
		printf 'cc-talk: %s\n' "$1"
	fi
}

# Tolerate a missing engine the way `gag` does: the shim exits 0 when pi-talk
# isn't installed, and so does the speaker when nothing is playing.
speak_control() {
	cc-talk-speak "--$1" >/dev/null 2>&1 || true
	printf 'cc-talk: %sd\n' "$1"
}

# Switch a session on, silently: the callers disagree about where the
# confirmation belongs (stdout from a shell, status line from a tmux key).
enable_id() {
	mkdir -p "$on_dir" || exit 1
	: >"$on_dir/$(session_key "$1")" || exit 1
}

enable_session() {
	scope=$1
	mkdir -p "$on_dir" || exit 1
	if [ "$scope" = global ]; then
		: >"$on_dir/global" || exit 1
		printf 'cc-talk: on for every session on this machine.\n\n'
		return 0
	fi
	enable_id "$CLAUDE_CODE_SESSION_ID"
	# Claim the pane now rather than making the user finish a turn first: this
	# is the earliest moment both halves of the map are in one process.
	record_pane "$CLAUDE_CODE_SESSION_ID"
	printf 'cc-talk: on for this session — replies will be spoken at the end of each turn.\n\n'
}

require_session() {
	[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && return 0
	printf '%s: no CLAUDE_CODE_SESSION_ID here — run %s inside a Claude Code session, or `%s --global` to enable every session.\n' \
		"$prog" "$prog" "$prog" >&2
	exit 1
}

prune_stale
drop_legacy

case "${1:-}" in
	cycle)
		# One key, three meanings. Invoked from tmux as well as from a shell,
		# and tmux's run-shell does not inherit the focused pane's environment,
		# so the session id is never in scope there. `--pane` is how the key
		# names the session anyway: tmux knows which pane is focused, and the
		# Stop hook knows which session lives in it.
		case "${2:-}" in
			--pane)
				# From the tmux keybind a non-zero exit throws a fullscreen
				# run-shell report; a status-line message is the right volume.
				if ! target=$(pane_session "${3:-}"); then
					msg="$prog: no cc-talk session in this pane yet — run \`$prog\` in it once, or let it finish a turn."
					if [ -n "${TMUX:-}" ]; then
						tmux display-message "$msg"
						exit 0
					fi
					printf '%s\n' "$msg" >&2
					exit 1
				fi
				if ! id_enabled "$target"; then
					enable_id "$target"
					# The disclosure is a page of text and this caller has
					# nowhere to put it — stdout here opens tmux's fullscreen
					# report view. The first spoken turn carries the reminder.
					confirm "on for this session — the first spoken turn shows the disclosure"
					exit 0
				fi
				;;
			"")
				if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || [ -e "$on_dir/global" ]; then
					if ! session_enabled; then
						enable_session session
						disclosure
						exit 0
					fi
				elif [ -z "$(live_speaker 2>/dev/null)" ]; then
					msg="$prog: nothing is speaking, and no CLAUDE_CODE_SESSION_ID here to enable — run \`$prog\` inside the session you want spoken."
					if [ -n "${TMUX:-}" ]; then
						tmux display-message "$msg"
						exit 0
					fi
					printf '%s\n' "$msg" >&2
					exit 1
				fi
				;;
			*)
				printf '%s: unknown argument: %s (try --help)\n' "$prog" "$2" >&2
				exit 1
				;;
		esac

		# Idle folds in with playing: pausing silence is a harmless no-op, and
		# it keeps the next press on the same footing as the contract's states.
		# Stdout from a tmux run-shell keybind opens the fullscreen report
		# view, so under tmux the confirmation goes to the status line.
		case $(speaker_state) in
			paused) did=unpaused; speak_control unpause >/dev/null ;;
			*) did=paused; speak_control pause >/dev/null ;;
		esac
		confirm "$did"
		exit 0
		;;
	pause|unpause)
		# The engine freezes mpv in place rather than killing it, so unpause
		# continues mid-sentence.
		speak_control "$1"
		exit 0
		;;
	speed)
		# There is no way to talk to a daemon that is already speaking — the
		# speed rides no signal — so the file is the channel. The daemon
		# re-reads it before every chunk, which is why a nudge from the tmux
		# key is heard within a sentence instead of at the next turn.
		case "${2:-}" in
			"")
				set -- $(speed_effective)
				printf 'cc-talk: speed %s× (%s)\n' "$1" "$2"
				exit 0
				;;
			reset)
				rm -f "$speed_file" 2>/dev/null
				set -- $(speed_effective)
				confirm "speed reset to $1× ($2)"
				exit 0
				;;
		esac

		if ! speed_is_number "$2"; then
			printf '%s: not a speed: %s (try `%s speed 1.50`, `%s speed +0.10`, or `%s speed reset`)\n' \
				"$prog" "$2" "$prog" "$prog" "$prog" >&2
			exit 1
		fi

		# A leading sign means "relative to whatever is in force now"; anything
		# else is the speed itself.
		case "$2" in
			[+-]*)
				current=$(speed_effective | awk '{ print $1 }')
				target=$(awk -v a="$current" -v d="$2" 'BEGIN { printf "%.4f\n", a + d }')
				;;
			*) target=$2 ;;
		esac

		new=$(speed_clamp "$target")
		mkdir -p "$state_dir" || exit 1
		printf '%s\n' "$new" >"$speed_file" || exit 1
		confirm "speed ${new}×"
		exit 0
		;;
	status)
		if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ -e "$on_dir/$(session_key "$CLAUDE_CODE_SESSION_ID")" ]; then
			printf 'this session:   on\n'
		elif [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
			printf 'this session:   off\n'
		else
			printf 'this session:   unknown (no CLAUDE_CODE_SESSION_ID here)\n'
		fi

		if [ -e "$on_dir/global" ]; then
			printf 'global:         on\n'
		else
			printf 'global:         off\n'
		fi

		others=0
		own=""
		[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && own=$(session_key "$CLAUDE_CODE_SESSION_ID")
		if [ -d "$on_dir" ]; then
			for f in "$on_dir"/*; do
				[ -f "$f" ] || continue
				name=${f##*/}
				[ "$name" = global ] && continue
				[ -n "$own" ] && [ "$name" = "$own" ] && continue
				others=$((others + 1))
			done
		fi
		printf 'other sessions: %s enabled\n' "$others"

		if pid=$(live_speaker); then
			printf 'speaker:        %s (pid %s)\n' "$(speaker_state)" "$pid"
		else
			printf 'speaker:        idle\n'
		fi
		exit 0
		;;
	-h|--help|help)
		usage
		exit 0
		;;
	--global)
		enable_session global
		disclosure
		exit 0
		;;
	"")
		require_session
		enable_session session
		disclosure
		exit 0
		;;
	*)
		printf '%s: unknown argument: %s (try --help)\n' "$prog" "$1" >&2
		exit 1
		;;
esac
