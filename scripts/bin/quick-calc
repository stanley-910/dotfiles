#!/usr/bin/python3
"""Free-form currency, world clock, date and math answers for a launcher's script hook.

    quick-calc 100 usd to cad           140.23 CAD
    quick-calc 50 € in $, hkd           55.75 USD · 437.33 HKD
    quick-calc 1.5k hkd                 converts to DEFAULT_TARGETS
    quick-calc time in tokyo            8:47 PM Wed · Tokyo (JST, UTC+9)
    quick-calc tokyo, sf, london        one answer per place, joined with " · "
    quick-calc 3pm london in nyc        11:00 AM Wed · NYC (EDT, UTC−4)
    quick-calc two weeks from thursday  Thursday, November 12, 2026 · in 15 days
    quick-calc days until christmas     58 days (8 weeks 2 days) · Friday, ...
    quick-calc last tuesday             Tuesday, October 27, 2026 · yesterday
    quick-calc 15% off 80               68  (also 5!, 17 mod 5, sin(90°), 255 in hex)

Prints one line, or nothing when the input is none of these, so the launcher shows
no answer row. Built for Vorssaint's Command Bar script links (the query
arrives as argv), but any shell can call it.

Rates are the ECB's daily euro reference rates (about 30 major currencies;
no TWD, AED or crypto), cached in ~/.cache/quick-calc. The first run waits for
the download; after that a cache over a day old is refreshed by a detached
curl for next time, and the current answer uses what is on disk. Stdlib and
/usr/bin/curl only, Python 3.9+.
"""

import math
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo, available_timezones

DEFAULT_TARGETS = ["HKD", "CAD", "USD"]
ECB_URL = "https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml"
RATES = os.path.expanduser("~/.cache/quick-calc/eurofxref-daily.xml")

# Everyday names the IANA database spells differently or not at all. City
# names that ARE in it ("tokyo", "sao paulo") resolve without an entry here.
PLACE_ALIASES = {
    "sf": "America/Los_Angeles", "san francisco": "America/Los_Angeles",
    "la": "America/Los_Angeles", "seattle": "America/Los_Angeles",
    "nyc": "America/New_York", "ny": "America/New_York",
    "boston": "America/New_York", "dc": "America/New_York",
    "washington": "America/New_York", "miami": "America/New_York",
    "austin": "America/Chicago", "dallas": "America/Chicago",
    "houston": "America/Chicago", "ottawa": "America/Toronto",
    "quebec": "America/Toronto", "calgary": "America/Edmonton",
    "beijing": "Asia/Shanghai", "shenzhen": "Asia/Shanghai",
    "guangzhou": "Asia/Shanghai", "hk": "Asia/Hong_Kong",
    "macau": "Asia/Macau", "taipei": "Asia/Taipei", "seoul": "Asia/Seoul",
    "delhi": "Asia/Kolkata", "new delhi": "Asia/Kolkata",
    "mumbai": "Asia/Kolkata", "bangalore": "Asia/Kolkata",
    "sg": "Asia/Singapore", "osaka": "Asia/Tokyo", "kyoto": "Asia/Tokyo",
    "munich": "Europe/Berlin", "frankfurt": "Europe/Berlin",
    "barcelona": "Europe/Madrid", "milan": "Europe/Rome",
    "geneva": "Europe/Zurich", "edinburgh": "Europe/London",
    "melbourne": "Australia/Melbourne", "sydney": "Australia/Sydney",
    # countries with one zone, or one everybody means
    "japan": "Asia/Tokyo", "china": "Asia/Shanghai", "korea": "Asia/Seoul",
    "taiwan": "Asia/Taipei", "india": "Asia/Kolkata", "uk": "Europe/London",
    "england": "Europe/London", "france": "Europe/Paris",
    "germany": "Europe/Berlin", "spain": "Europe/Madrid",
    "italy": "Europe/Rome", "hong kong": "Asia/Hong_Kong",
    # abbreviations, read as the place that observes them (DST-aware)
    "pt": "America/Los_Angeles", "pst": "America/Los_Angeles",
    "pdt": "America/Los_Angeles", "mt": "America/Denver",
    "mst": "America/Denver", "mdt": "America/Denver",
    "ct": "America/Chicago", "cst": "America/Chicago",
    "cdt": "America/Chicago", "et": "America/New_York",
    "est": "America/New_York", "edt": "America/New_York",
    "bst": "Europe/London", "cet": "Europe/Paris", "cest": "Europe/Paris",
    "jst": "Asia/Tokyo", "kst": "Asia/Seoul", "hkt": "Asia/Hong_Kong",
    "sgt": "Asia/Singapore", "ist": "Asia/Kolkata",
    "aest": "Australia/Sydney", "aedt": "Australia/Sydney",
    "utc": "UTC", "gmt": "UTC", "z": "UTC",
}

CURRENCY_ALIASES = {
    "$": "USD", "us$": "USD", "dollar": "USD", "dollars": "USD",
    "bucks": "USD", "c$": "CAD", "ca$": "CAD", "hk$": "HKD", "a$": "AUD",
    "€": "EUR", "euro": "EUR", "euros": "EUR", "£": "GBP", "quid": "GBP",
    "¥": "JPY", "yen": "JPY", "rmb": "CNY", "yuan": "CNY", "kuai": "CNY",
    "won": "KRW", "₩": "KRW", "₹": "INR", "rupees": "INR",
}


def zone_index():
    index = {}
    for name in available_timezones():
        city = name.rsplit("/", 1)[-1].replace("_", " ").lower()
        index.setdefault(city, name)
    index.update(PLACE_ALIASES)
    return index


ZONES = zone_index()


def place(text):
    """(ZoneInfo, label) for a place name, abbreviation or UTC±N; or None."""
    key = re.sub(r"\s+", " ", text.strip().lower().rstrip("?."))
    m = re.fullmatch(r"(?:utc|gmt)\s*([+-−])\s*(\d{1,2})(?::?(\d{2}))?", key)
    if m:
        sign = -1 if m.group(1) in "-−" else 1
        hours, minutes = int(m.group(2)), int(m.group(3) or 0)
        # Etc/GMT names invert the sign; only whole hours exist there.
        if minutes == 0 and hours <= 14:
            zone = "Etc/GMT%+d" % (-sign * hours) if hours else "UTC"
            return ZoneInfo(zone), "UTC%s%d" % ("+" if sign > 0 else "−", hours)
        return None
    zone = ZONES.get(key)
    if not zone:
        return None
    if zone == "UTC":
        label = "UTC"
    elif key in PLACE_ALIASES and len(key) > 4:
        label = key.title()  # "san francisco", not the zone's "Los Angeles"
    elif key in PLACE_ALIASES and key in ("sf", "la", "nyc", "ny", "dc", "hk", "sg", "uk"):
        label = key.upper()
    else:
        label = zone.rsplit("/", 1)[-1].replace("_", " ")
    return ZoneInfo(zone), label


def offset_text(dt):
    total = int(dt.utcoffset().total_seconds() // 60)
    sign = "+" if total >= 0 else "−"
    h, m = divmod(abs(total), 60)
    utc = "UTC%s%d%s" % (sign, h, ":%02d" % m if m else "")
    abbr = dt.tzname() or ""
    return utc if not abbr or abbr[0] in "+-" or abbr == "UTC" else "%s, %s" % (abbr, utc)


def describe(dt, reference, label):
    zone = "" if label.startswith("UTC") else " (%s)" % offset_text(dt)
    return "%s · %s%s" % (clock(dt, reference), label, zone)


def clock(dt, reference):
    text = dt.strftime("%-I:%M %p %a")
    days = (dt.date() - reference.date()).days
    return text + (" (%+d day)" % days if days else "")


def parse_clock(text):
    """A wall-clock time like 3pm, 15:00, 9:30am, noon; as (hour, minute)."""
    t = text.strip().lower()
    if t in ("noon", "midday"):
        return 12, 0
    if t == "midnight":
        return 0, 0
    m = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?\s*(am|pm|a|p)?", t)
    if not m or (m.group(2) is None and m.group(3) is None):
        return None
    hour, minute, meridiem = int(m.group(1)), int(m.group(2) or 0), m.group(3)
    if meridiem:
        if not 1 <= hour <= 12:
            return None
        hour = hour % 12 + (12 if meridiem.startswith("p") else 0)
    if hour > 23 or minute > 59:
        return None
    return hour, minute


def places(text):
    found = [place(p) for p in re.split(r"\s*(?:,|\band\b|&)\s*", text) if p]
    return found if found and all(found) else None


def answer_time(q):
    local = datetime.now().astimezone()
    lowered = q.lower().strip().rstrip("?")
    # "time in tokyo", "what time is it in sf", "tokyo time", "tokyo, london"
    m = re.fullmatch(r"(?:(?:what\s+)?time(?:\s+is\s+it)?|now|current\s+time)\s+(?:in|at)\s+(.+)", lowered) \
        or re.fullmatch(r"(.+?)\s+time", lowered)
    targets = places(m.group(1)) if m else places(lowered)
    if targets:
        return " · ".join(describe(local.astimezone(z), local, label)
                          for z, label in targets)
    # "3pm london in new york", "15:00 in tokyo", "now in utc", "9am pst to hk"
    m = re.fullmatch(r"(.+?)\s+(?:in|to|->|→)\s+(.+)", lowered)
    if not m:
        return None
    left, dests = m.group(1), places(m.group(2))
    if not dests:
        return None
    words = left.split()
    source, when = None, None
    for split in range(len(words), 0, -1):
        moment = " ".join(words[:split])
        rest = " ".join(words[split:])
        hm = (local.hour, local.minute) if moment == "now" else parse_clock(moment)
        if hm and (not rest or place(rest)):
            zone = place(rest)[0] if rest else local.tzinfo
            base = datetime.now(zone) if moment == "now" else None
            if base is None:
                today = datetime.now(zone)
                base = today.replace(hour=hm[0], minute=hm[1], second=0, microsecond=0)
            source, when = zone, base
            break
    if when is None:
        return None
    return " · ".join(describe(when.astimezone(z), when, label)
                      for z, label in dests)


def load_rates():
    """Units of each currency per 1 EUR, or None when nothing is cached."""
    if not os.path.exists(RATES):
        fetch_rates(wait=True)
    elif time.time() - os.path.getmtime(RATES) > 86400:
        fetch_rates(wait=False)
    try:
        with open(RATES) as f:
            found = re.findall(r"currency='([A-Z]{3})' rate='([\d.]+)'", f.read())
    except OSError:
        return None
    if not found:
        return None
    rates = {code: float(rate) for code, rate in found}
    rates["EUR"] = 1.0
    return rates


def fetch_rates(wait):
    # Download beside the cache, then rename: a reader never sees half a file.
    os.makedirs(os.path.dirname(RATES), exist_ok=True)
    partial = RATES + ".part"
    command = ["/bin/sh", "-c",
               'curl -fsS --max-time 5 -o "$1" "$2" && mv "$1" "$3"',
               "sh", partial, ECB_URL, RATES]
    if wait:
        subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.Popen(command, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def currency(token, rates):
    t = token.strip().lower()
    code = CURRENCY_ALIASES.get(t, t.upper())
    return code if code in rates else None


def amount(text):
    m = re.fullmatch(r"([\d.,]+)\s*([km])?", text.strip().lower())
    if not m:
        return None
    try:
        value = float(m.group(1).replace(",", ""))
    except ValueError:
        return None
    return value * {"k": 1e3, "m": 1e6}.get(m.group(2), 1)


def money(value, code):
    if abs(value) >= 1 or value == 0:
        return "{:,.2f} {}".format(value, code)
    return "{:.6g} {}".format(value, code)


def answer_currency(q):
    s = q.strip().lower()
    # Separate symbols glued to numbers: "$100", "100€", "hk$50".
    s = re.sub(r"((?:us|c|ca|hk|a)?\$|€|£|¥|₩|₹)", r" \1 ", s)
    m = re.fullmatch(r"\s*(?:(\S+)\s+)?([\d.,]+\s*[km]?)\s*(\S+)?\s*(?:(?:to|in|->|→|=)\s+(.+?))?\s*", s)
    if not m:
        return None
    pre, num, post, dest = m.groups()
    value = amount(num)
    if value is None or (pre is None) == (post is None):
        return None
    rates = load_rates()
    if not rates:
        return None
    src = currency(pre or post, rates)
    if not src:
        return None
    targets = [currency(t, rates) for t in re.split(r"\s*(?:,|\band\b|&|\s)\s*", dest) if t] \
        if dest else [c for c in DEFAULT_TARGETS if c != src]
    if not targets or not all(targets):
        return None
    return " · ".join(money(value / rates[src] * rates[t], t) for t in targets)


WEEKDAYS = ["monday", "tuesday", "wednesday", "thursday", "friday",
            "saturday", "sunday"]
MONTHS = ["january", "february", "march", "april", "may", "june", "july",
          "august", "september", "october", "november", "december"]
NUMBER_WORDS = {w: i for i, w in enumerate(
    "zero one two three four five six seven eight nine ten eleven twelve "
    "thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty".split())}
NUMBER_WORDS.update({"a": 1, "an": 1, "a couple": 2, "couple": 2, "a few": 3})
DATE_UNITS = {"day": "days", "week": "weeks", "fortnight": "fortnights",
              "month": "months", "year": "years"}


def weekday_index(word):
    word = word.rstrip("s") if word.endswith("days") else word
    for i, name in enumerate(WEEKDAYS):
        if word in (name, name[:3], name[:4]):
            return i
    return None


def month_index(word):
    for i, name in enumerate(MONTHS):
        if word == name or (len(word) >= 3 and name.startswith(word)):
            return i + 1
    return None


def add_months(day, months):
    total = day.month - 1 + months
    year, month = day.year + total // 12, total % 12 + 1
    for d in (day.day, 30, 29, 28):  # Jan 31 + 1 month lands on Feb 28/29
        try:
            return day.replace(year=year, month=month, day=d)
        except ValueError:
            continue


def calendar_date(text, today, future):
    """'dec 25', '25 december', '12/25', '2026-12-25', 'christmas'. A date
    without a year that has already passed means next year when `future`."""
    t = text.replace(",", " ").replace("'s", "").split()
    t = " ".join(t)
    named = {"christmas": (12, 25), "xmas": (12, 25), "new year": (1, 1),
             "new years": (1, 1), "new years day": (1, 1),
             "halloween": (10, 31), "valentines": (2, 14), "valentines day": (2, 14)}
    month = day = year = None
    m = re.fullmatch(r"(\d{4})-(\d{1,2})-(\d{1,2})", t)
    if m:
        year, month, day = map(int, m.groups())
    elif t in named:
        month, day = named[t]
    else:
        m = re.fullmatch(r"(\d{1,2})/(\d{1,2})(?:/(\d{2,4}))?", t)
        if m:
            month, day = int(m.group(1)), int(m.group(2))
            year = m.group(3) and int(m.group(3)) % 100 + 2000
        else:
            m = re.fullmatch(r"([a-z]+)\.?\s+(\d{1,2})(?:st|nd|rd|th)?(?:\s+(\d{4}))?", t) \
                or re.fullmatch(r"(\d{1,2})(?:st|nd|rd|th)?\s+([a-z]+)\.?(?:\s+(\d{4}))?", t)
            if not m:
                return None
            a, b, y = m.groups()
            month, day = (month_index(a), int(b)) if a.isalpha() else (month_index(b), int(a))
            year = y and int(y)
            if not month:
                return None
    try:
        result = today.replace(year=year or today.year, month=month, day=day)
    except ValueError:
        return None
    if year is None and future and result < today:
        result = result.replace(year=result.year + 1)
    return result


def anchor(text, today):
    """A day named relative to today, or None."""
    t = re.sub(r"^(?:the\s+)?", "", text.strip())
    if t in ("today", "now", "tonight"):
        return today
    if t == "tomorrow":
        return today + timedelta(days=1)
    if t == "yesterday":
        return today - timedelta(days=1)
    m = re.fullmatch(r"(?:(this|next|last|coming|past)\s+)?([a-z]+)", t)
    if m and weekday_index(m.group(2)) is not None:
        target, which = weekday_index(m.group(2)), m.group(1)
        ahead = (target - today.weekday()) % 7
        if which in ("last", "past"):
            return today - timedelta(days=(today.weekday() - target) % 7 or 7)
        if which == "this":
            return today + timedelta(days=ahead)
        return today + timedelta(days=ahead or 7)
    m = re.fullmatch(r"(next|last)\s+(week|month|year)", t)
    if m:
        step = 1 if m.group(1) == "next" else -1
        return shift(today, step, m.group(2) + "s")
    return calendar_date(t, today, future=True)


def count(text):
    text = text.strip()
    if text in NUMBER_WORDS:
        return NUMBER_WORDS[text]
    try:
        return float(text) if "." in text else int(text)
    except ValueError:
        return None


def shift(day, n, unit):
    if unit == "days":
        return day + timedelta(days=n)
    if unit in ("weeks", "fortnights"):
        return day + timedelta(weeks=n * (2 if unit == "fortnights" else 1))
    if unit == "months":
        return add_months(day, int(n))
    return add_months(day, int(n) * 12)


def offsets(text):
    """'2 weeks', 'two weeks and 3 days', 'a month' as [(n, unit)], or None."""
    parts = re.split(r"\s*(?:,|\band\b|\+)\s*", text.strip())
    found = []
    for part in parts:
        m = re.fullmatch(r"(.+?)\s*(day|week|fortnight|month|year)s?", part.strip())
        n = m and count(m.group(1))
        if n is None or not m:
            return None
        found.append((n, DATE_UNITS[m.group(2)]))
    return found or None


def date_line(day, today):
    gap = (day - today).days
    when = {0: "today", 1: "tomorrow", -1: "yesterday"}.get(gap) or (
        "in %d days" % gap if gap > 0 else "%d days ago" % -gap)
    return "%s · %s" % (day.strftime("%A, %B %-d, %Y"), when)


def span(days):
    weeks, rest = divmod(abs(days), 7)
    detail = "%d weeks %d days" % (weeks, rest) if weeks and rest else (
        "%d weeks" % weeks if weeks else "")
    return "%d days%s" % (days, " (%s)" % detail if detail else "")


def answer_date(q):
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    t = re.sub(r"\s+", " ", q.lower().strip().rstrip("?"))
    t = re.sub(r"^(?:what(?:'s| is)?\s+(?:the\s+)?(?:day|date)\s+(?:is|was|will be|of)?\s*"
               r"|when is\s+|what day is\s+)", "", t).strip()

    # days until christmas / how long until friday / until dec 25
    m = re.fullmatch(r"(?:(?:how many\s+)?days|how long)?\s*(?:until|till|to|before)\s+(.+)", t)
    if m and (t.startswith(("days", "how", "until", "till"))):
        day = anchor(m.group(1), today)
        if day:
            return "%s · %s" % (span((day - today).days), day.strftime("%A, %B %-d, %Y"))
    # days between jan 1 and mar 15 / days from monday to friday
    m = re.fullmatch(r"(?:days|time)\s+(?:between|from)\s+(.+?)\s+(?:and|to|until)\s+(.+)", t)
    if m:
        a, b = anchor(m.group(1), today), anchor(m.group(2), today)
        if a and b:
            # "monday to friday" means the friday after that monday
            if b < a and weekday_index(m.group(2).split()[-1]) is not None:
                b += timedelta(days=7 * -(-(a - b).days // 7))
            return span((b - a).days)
    # 3 days ago / in two weeks
    m = re.fullmatch(r"(.+?)\s+ago", t)
    if m and offsets(m.group(1)):
        day = today
        for n, unit in offsets(m.group(1)):
            day = shift(day, -n, unit)
        return date_line(day, today)
    m = re.fullmatch(r"in\s+(.+)", t)
    if m and offsets(m.group(1)):
        day = today
        for n, unit in offsets(m.group(1)):
            day = shift(day, n, unit)
        return date_line(day, today)
    # two weeks from thursday / 10 days after dec 25 / a month before christmas
    m = re.fullmatch(r"(.+?)\s+(from|after|before)\s+(.+)", t)
    if m and offsets(m.group(1)):
        day = anchor(m.group(3), today)
        if day:
            sign = -1 if m.group(2) == "before" else 1
            for n, unit in offsets(m.group(1)):
                day = shift(day, sign * n, unit)
            return date_line(day, today)
    # thursday + 2 weeks / christmas - 10 days
    m = re.fullmatch(r"(.+?)\s*(\+|-|plus|minus)\s*(.+)", t)
    if m and offsets(m.group(3)):
        day = anchor(m.group(1), today)
        if day:
            sign = -1 if m.group(2) in ("-", "minus") else 1
            for n, unit in offsets(m.group(3)):
                day = shift(day, sign * n, unit)
            return date_line(day, today)
    # next friday / last tuesday / dec 25 / christmas. A bare "1/3" is a
    # division, not January 3rd; slash dates still work after "until" etc.
    if re.fullmatch(r"\d+/\d+", t):
        return None
    day = anchor(t, today)
    if day and t not in ("today", "now", "tonight"):
        return date_line(day, today)
    if t in ("today", "date", "the date"):
        return date_line(today, today)
    return None


MATH_FUNCS = {
    "sqrt": math.sqrt, "cbrt": lambda x: math.copysign(abs(x) ** (1 / 3), x),
    "sin": math.sin, "cos": math.cos, "tan": math.tan,
    "asin": math.asin, "acos": math.acos, "atan": math.atan,
    "log": math.log10, "ln": math.log, "log2": math.log2, "exp": math.exp,
    "abs": abs, "round": round, "floor": math.floor, "ceil": math.ceil,
    "fact": lambda n: math.factorial(int(n)) if n == int(n) and 0 <= n <= 170 else None,
}
MATH_CONSTS = {"pi": math.pi, "π": math.pi, "e": math.e, "tau": math.tau}
FRACTION_WORDS = {"half": 0.5, "a half": 0.5, "a third": 1 / 3, "third": 1 / 3,
                  "a quarter": 0.25, "quarter": 0.25, "twice": 2, "double": 2,
                  "triple": 3}
BASES = {"hex": (16, "0x"), "hexadecimal": (16, "0x"), "binary": (2, "0b"),
         "bin": (2, "0b"), "octal": (8, "0o"), "oct": (8, "0o"),
         "decimal": (10, ""), "dec": (10, "")}


def evaluate(expr):
    """Evaluate arithmetic safely: numbers, + - * / ^ %, whitelisted calls."""
    import ast
    expr = expr.strip()
    expr = re.sub(r"(?<=\d),(?=\d{3}\b)", "", expr)          # 1,000 -> 1000
    expr = expr.replace("×", "*").replace("÷", "/").replace("−", "-")
    expr = re.sub(r"(?<=[\d)])\s*x\s*(?=[\d(])", "*", expr)  # 3 x 4
    expr = re.sub(r"\bmod\b", "%", expr)
    expr = re.sub(r"(\d+(?:\.\d+)?|\))\s*°", r"\1*pi/180", expr)
    expr = re.sub(r"(\d+(?:\.\d+)?)\s*!", r"fact(\1)", expr)
    expr = re.sub(r"(\d+(?:\.\d+)?)\s*%(?!\s*[\d(a-z])", r"(\1/100)", expr)
    expr = expr.replace("^", "**")
    try:
        tree = ast.parse(expr, mode="eval")
    except SyntaxError:
        return None
    ops = {ast.Add: lambda a, b: a + b, ast.Sub: lambda a, b: a - b,
           ast.Mult: lambda a, b: a * b, ast.Div: lambda a, b: a / b,
           ast.Mod: lambda a, b: a % b, ast.FloorDiv: lambda a, b: a // b,
           ast.Pow: lambda a, b: a ** b if abs(b) <= 1000 else None}

    def walk(node):
        if isinstance(node, ast.Expression):
            return walk(node.body)
        if isinstance(node, ast.Constant) and type(node.value) in (int, float):
            return node.value
        if isinstance(node, ast.Name) and node.id in MATH_CONSTS:
            return MATH_CONSTS[node.id]
        if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.USub, ast.UAdd)):
            v = walk(node.operand)
            return None if v is None else (-v if isinstance(node.op, ast.USub) else v)
        if isinstance(node, ast.BinOp) and type(node.op) in ops:
            a, b = walk(node.left), walk(node.right)
            return None if a is None or b is None else ops[type(node.op)](a, b)
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) \
                and node.func.id in MATH_FUNCS and len(node.args) == 1 and not node.keywords:
            v = walk(node.args[0])
            return None if v is None else MATH_FUNCS[node.func.id](v)
        raise ValueError
    try:
        value = walk(tree)
    except (ValueError, ArithmeticError, OverflowError, TypeError):
        return None
    if isinstance(value, complex) or value is None:
        return None
    return value


def number(value):
    if isinstance(value, int) or (isinstance(value, float) and value.is_integer()
                                  and abs(value) < 1e15):
        return "{:,}".format(int(value))
    if abs(value) >= 1e15 or abs(value) < 1e-6:
        return "{:.10g}".format(value)
    return "{:,.10f}".format(value).rstrip("0").rstrip(".")


def answer_math(q):
    t = re.sub(r"\s+", " ", q.lower().strip().rstrip("?=").strip())
    t = re.sub(r"^(?:what(?:'s| is)\s+|calc(?:ulate)?\s+)", "", t)
    # 255 in hex / 0xff in decimal / 0b1010 to dec
    m = re.fullmatch(r"(.+?)\s+(?:in|to|as)\s+(" + "|".join(BASES) + r")", t)
    if m:
        value = evaluate(m.group(1))
        if value is None or value != int(value):
            return None
        base, prefix = BASES[m.group(2)]
        n = int(value)
        digits = {16: "%x", 8: "%o", 10: "%d"}.get(base, "")
        text = format(abs(n), "b") if base == 2 else (digits % abs(n))
        return ("-" if n < 0 else "") + prefix + text.upper().replace("0X", "0x")
    # 20% of 50 / 15% off 80 / 50 + 20% / half of 80
    m = re.fullmatch(r"(.+?)\s*%\s*(of|off)\s+(.+)", t)
    if m:
        p, base = evaluate(m.group(1)), evaluate(m.group(3))
        if p is None or base is None:
            return None
        return number(base * p / 100 if m.group(2) == "of" else base * (1 - p / 100))
    m = re.fullmatch(r"(.+?)\s*([+-])\s*(\d+(?:\.\d+)?)\s*%", t)
    if m:
        base, p = evaluate(m.group(1)), float(m.group(3))
        if base is None:
            return None
        return number(base * (1 + p / 100 if m.group(2) == "+" else 1 - p / 100))
    m = re.fullmatch(r"(" + "|".join(FRACTION_WORDS) + r")\s+(?:of\s+)?(.+)", t)
    if m:
        value = evaluate(m.group(2))
        return None if value is None else number(FRACTION_WORDS[m.group(1)] * value)
    # Plain expressions; a lone number is not a question (hex/binary aside).
    if not re.search(r"[-+*/^%!×÷°()]|\bmod\b|\d\s*x\s*\d|[a-z]{2,}\(|0[xbo][0-9a-f]", t):
        return None
    value = evaluate(t)
    return None if value is None else number(value)


def main():
    q = " ".join(sys.argv[1:]).strip()
    if not q:
        return
    result = answer_currency(q) or answer_time(q) or answer_date(q) or answer_math(q)
    if result:
        print(result)


if __name__ == "__main__":
    main()
