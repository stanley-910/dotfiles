#!/usr/bin/env bash

cat <<'EOF'
Git Menu        

h  :  Open Remote Repository (current branch)
H  :  Open Remote Repository (main branch)
p  :  Open Pull Requests By Current User 
P  :  Search Pull Requests By Current Ticket
j  :  Open Jira Ticket URL
J  :  Open Jira Board URL
b  :  Open Pipeline Build
m  :  Open Agent MR / PR
i  :  Open Agent Issue
y  :  Copy Agent Worktree Path

Press key to execute
EOF

# Keep the popup open until a key is pressed
read -n 1 -s key

# Execute the corresponding action based on key pressed
case "$key" in
h)
  ~/.config/scripts/open_remote.sh h
  ;;
H)
  ~/.config/scripts/open_remote.sh H
  ;;
p)
  ~/.config/scripts/open_remote.sh p
  ;;
P)
  ~/.config/scripts/open_remote.sh P
  ;;
j)
  ~/.config/scripts/open_ticket.sh j
  ;;
J)
  ~/.config/scripts/open_ticket.sh J
  ;;
b)
  ~/.config/scripts/open_remote.sh b
  ;;
# agent-link lives in scripts/bin (on PATH via .zshenv, but tmux popups may not
# have it), so reference it directly.
m)
  "$HOME/dotfiles/scripts/bin/agent-link" open mr
  ;;
i)
  "$HOME/dotfiles/scripts/bin/agent-link" open issue
  ;;
y)
  "$HOME/dotfiles/scripts/bin/agent-link" copy
  ;;

*)
  echo "Invalid option: $key"
  ;;
esac
