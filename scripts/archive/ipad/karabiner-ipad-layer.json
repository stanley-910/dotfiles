{
    "description": "Ctrl+Cmd+I iPad layer: release alone connects; +h/l connect left/right; +r rotates; +d disconnects (must stay first: overrides other h/l/d rules while held)",
    "manipulators": [
        {
            "from": {
                "key_code": "i",
                "modifiers": {
                    "mandatory": [
                        "control",
                        "command"
                    ]
                }
            },
            "to": [
                {
                    "set_variable": {
                        "name": "ipad_chord",
                        "value": 1
                    }
                },
                {
                    "set_notification_message": {
                        "id": "ipad_chord",
                        "text": "iPad — release: connect · h left · l right · r rotate · d disconnect"
                    }
                }
            ],
            "to_after_key_up": [
                {
                    "set_variable": {
                        "name": "ipad_chord",
                        "value": 0
                    }
                },
                {
                    "set_notification_message": {
                        "id": "ipad_chord",
                        "text": ""
                    }
                },
                {
                    "shell_command": "/Users/stanley/dotfiles/scripts/bin/ipad chord-fire"
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "ipad_chord",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "from": {
                "key_code": "d",
                "modifiers": {
                    "optional": [
                        "any"
                    ]
                }
            },
            "to": [
                {
                    "shell_command": "/Users/stanley/dotfiles/scripts/bin/ipad chord-add d"
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "ipad_chord",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "from": {
                "key_code": "h",
                "modifiers": {
                    "optional": [
                        "any"
                    ]
                }
            },
            "to": [
                {
                    "shell_command": "/Users/stanley/dotfiles/scripts/bin/ipad chord-add h"
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "ipad_chord",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "from": {
                "key_code": "l",
                "modifiers": {
                    "optional": [
                        "any"
                    ]
                }
            },
            "to": [
                {
                    "shell_command": "/Users/stanley/dotfiles/scripts/bin/ipad chord-add l"
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "ipad_chord",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "from": {
                "key_code": "r",
                "modifiers": {
                    "optional": [
                        "any"
                    ]
                }
            },
            "to": [
                {
                    "shell_command": "/Users/stanley/dotfiles/scripts/bin/ipad chord-add r"
                }
            ],
            "type": "basic"
        }
    ]
}